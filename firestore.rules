rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------
    // Helper functions
    // -------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isPlayer(gameData) {
      return request.auth.uid in gameData.playerIds;
    }

    function isHost(gameData) {
      return request.auth.uid == gameData.createdBy;
    }

    function gameIsWaiting(gameData) {
      return gameData.status == 'waiting';
    }

    function gameIsActive(gameData) {
      return gameData.status == 'active';
    }

    function gameIsFinished(gameData) {
      return gameData.status == 'finished';
    }

    // -------------------------------------------------------
    // Users collection
    // -------------------------------------------------------
    match /users/{userId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    // -------------------------------------------------------
    // Games collection
    // -------------------------------------------------------
    match /games/{gameId} {
      // Any authenticated user can read a game they are part of,
      // or read 'waiting' games (needed to join via code).
      allow read: if isSignedIn() &&
                     (isPlayer(resource.data) || resource.data.status == 'waiting');

      // Any signed-in user can create a game
      allow create: if isSignedIn() &&
                       request.resource.data.createdBy == request.auth.uid &&
                       request.resource.data.maxPlayers >= 2 &&
                       request.resource.data.maxPlayers <= 10 &&
                       request.resource.data.status == 'waiting';

      // Joining: a non-player can update ONLY the players/playerIds arrays on a waiting game
      allow update: if isSignedIn() &&
                       gameIsWaiting(resource.data) &&
                       // Only the players/playerIds fields change when joining
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['players', 'playerIds']) &&
                       // The joining user adds themselves
                       request.auth.uid in request.resource.data.playerIds;

      // Host can start game (status: waiting → active)
      allow update: if isSignedIn() &&
                       isHost(resource.data) &&
                       gameIsWaiting(resource.data) &&
                       request.resource.data.status == 'active';

      // Players can update game state during active play
      // (submit turns, vote game over, finish game)
      allow update: if isSignedIn() &&
                       isPlayer(resource.data) &&
                       (gameIsActive(resource.data) || gameIsFinished(resource.data));

      allow delete: if false;

      // -------------------------------------------------------
      // Comments sub-collection (only on finished games)
      // -------------------------------------------------------
      match /comments/{commentId} {
        allow read:   if isSignedIn() && isPlayer(get(/databases/$(database)/documents/games/$(gameId)).data);
        allow create: if isSignedIn() &&
                         isPlayer(get(/databases/$(database)/documents/games/$(gameId)).data) &&
                         gameIsFinished(get(/databases/$(database)/documents/games/$(gameId)).data) &&
                         request.resource.data.userId == request.auth.uid &&
                         request.resource.data.text.size() > 0 &&
                         request.resource.data.text.size() <= 1000;
        allow update: if false;
        allow delete: if false;
      }
    }
  }
}
